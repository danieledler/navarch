{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "@desktop/*": ["../desktop/src/*"], "@mobile/*": ["../mobile/src/*"] }
  },
  "include": ["src", "../desktop/src/env.d.ts", "../mobile/src/env.d.ts"]
}
